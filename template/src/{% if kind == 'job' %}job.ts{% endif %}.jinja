// A scheduled job: no web address. The platform runs it on its schedule (make app-schedule, or the
// app page): each run does its work once, then ends. Exit status 0 is a successful run, anything else
// a failed one, which the platform reports to the team. Replace work() with the app's job.
import { SpanStatusCode, trace } from "@opentelemetry/api";
import pino from "pino";
import { closeEvents{% if events == 'asyncapi' %}, publish{% endif %} } from "./events.js";
import { {% if flags == 'example' %}flags, {% endif %}flagsLoaded, watchFlags } from "./flags.js";

export const logger = pino({
  level: process.env.LOG_LEVEL ?? "info",
});

const serviceName = process.env.OTEL_SERVICE_NAME ?? "swhurl-app";
const tracer = trace.getTracer(serviceName);
const FLAGS_WAIT_MS = 5_000; // the stored overrides arrive within this, or the declared values are used
const STOP_AFTER_MS = 30_000; // after the run: time to send telemetry and close connections

/** The job itself: throw to fail the run. */
async function work(): Promise<void> {
{%- if flags == 'example' %}
  // An example of a feature flag: fail-run is declared in swhurl.yaml, off everywhere. Turn it on for
  // an environment on the app page to see a failed run reported; turn it off again afterwards.
  if (flags.failRun) throw new Error("fail-run is on: this run fails on purpose");
{%- endif %}
{%- if events == 'asyncapi' %}
  // An example of publishing: "worked" is described in asyncapi.yaml, which is what lets other
  // apps find it and subscribe. Off the platform the payload is still checked, and nothing is sent.
  await publish("worked", { at: new Date().toISOString() });
{%- endif %}
{%- if flags == 'example' %}
  logger.info(flags.shout ? "WORK DONE" : "work done");
{%- else %}
  logger.info("work done");
{%- endif %}
}

/** One run of ``job`` inside a root span "run": the exit status it should end with, 0 or 1. */
export async function runOnce(job: () => Promise<void> = work): Promise<number> {
  const started = Date.now();
  return tracer.startActiveSpan("run", async (span) => {
    const trace_id = span.spanContext().traceId;
    try {
      await job();
      logger.info({ duration_ms: Date.now() - started, trace_id }, "run succeeded");
      return 0;
    } catch (error) {
      span.recordException(error as Error);
      span.setStatus({ code: SpanStatusCode.ERROR, message: (error as Error).message });
      logger.error({ err: error, duration_ms: Date.now() - started, trace_id }, "run failed");
      return 1;
    } finally {
      span.end();
    }
  });
}

/** The process: read the feature flag overrides, run once, then let Node exit with the run's status.
 * Node exits once nothing is left to do, after the OpenTelemetry SDK has sent what the run recorded
 * (it does that before exit, not on process.exit); a run that leaves something open is stopped. */
export async function main(): Promise<void> {
  watchFlags({ onProblem: (error) => logger.warn({ err: error }, "flag overrides") });
  for (let waited = 0; !flagsLoaded() && waited < FLAGS_WAIT_MS; waited += 100) {
    await new Promise((resolve) => setTimeout(resolve, 100));
  }
  process.exitCode = await runOnce();
  await closeEvents();
  setTimeout(() => {
    logger.warn({ after_ms: STOP_AFTER_MS }, "still running after the run: stopping");
    process.exit(process.exitCode);
  }, STOP_AFTER_MS).unref();
}
