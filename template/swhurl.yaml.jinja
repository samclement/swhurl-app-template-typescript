# This app's identity, what its image needs and what it offers, read by the swhurl platform.
# Each field and its kind: https://github.com/samclement/swhurl-platform/blob/main/docs/apps.md#swhurlyaml

# Identity: what the app is
version: 1
stack: typescript
kind: {{ kind }}
# One line saying what the app does: the platform passes it to the app as SWHURL_DESCRIPTION
description: {{ description | tojson }}

# Needs: what the image needs to run
{%- if kind == 'web' %}
port: 8080
healthPath: /healthz
{%- endif %}
uid: 65532
telemetry: otlp
{%- if database == 'sqlite' %}
database: sqlite
{%- endif %}
{%- set listed_api = kind == 'web' and api == 'openapi' and frontend != 'vite' %}

# Offers: what other apps can use
{%- if kind == 'web' and api == 'openapi' and frontend == 'vite' %}
# Its API (/api/*) serves its own browser frontend, so it is not offered to other apps: openapi.json
# stays in the repository to type its calls. Add provides.api and apiFile to offer it.
{%- endif %}
{%- if listed_api %}
# Its API description (served, and kept in the repository) and its events. The platform reads both
# files for every image; the events file says what the app publishes.
{%- else %}
# Its events: the platform reads asyncapi.yaml for every image; it says what the app publishes.
{%- endif %}
provides:
{%- if listed_api %}
  api: /openapi.json
  apiFile: openapi.json
{%- endif %}
  eventsFile: asyncapi.yaml
# Feature flags: typed, with a value per environment; the build generates src/flags.ts from them.
# https://github.com/samclement/swhurl-platform/blob/main/docs/apps.md#feature-flags
flags:
  shout:
    type: boolean
    description: Say hello in capitals
    default: false
    staging: true
{%- if kind == 'job' %}
  fail-run:
    type: boolean
    description: Make the example run fail, to see a failed run reported
    default: false
{%- endif %}

# Grants are set on the platform, not here: the team, who can reach the app, the apps it calls, the
# events it receives and its alerts (the console's New app form and app page, or make app-*).
